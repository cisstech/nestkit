{
  "name": "root",
  "version": "1.15.0",
  "description": "NestKit is a collection of libraries for NestJS developers.",
  "keywords": [
    "NestJS",
    "PubSub",
    "Redis",
    "TypeORM",
    "PostgreSQL"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/cisstech/nestkit"
  },
  "bugs": {
    "url": "https://github.com/cisstech/nestkit/issues"
  },
  "homepage": "https://github.com/cisstech/nestkit",
  "author": {
    "name": "Mamadou Cisse",
    "email": "mciissee@gmail.com"
  },
  "license": "MIT",
  "engines": {
    "node": "^22.22.3 || ^24.15.0 || >=26.0.0"
  },
  "scripts": {
    "nx": "nx",
    "npm": "npm",
    "typeorm": "ts-node --transpile-only -P tsconfig.base.json -r tsconfig-paths/register -O '{\"module\":\"commonjs\"}' ./node_modules/typeorm/cli.js -d ./apps/api/src/app/database/database.cli.ts",
    "start": "nx run-many --target=serve --parallel",
    "start:api": "nx run api:serve",
    "start:api:multi": "yarn concurrently --kill-others \"PORT=3000 yarn nx run api:serve\" \"PORT=3001 yarn nx run api:serve\"",
    "start:app": "nx run app:serve",
    "build": "yarn build:libs && yarn build:api && yarn build:app",
    "build:api": "nx run api:build --prod",
    "build:app": "nx run app:build --prod  --base-href='https://cisstech.github.io/nestkit/'",
    "build:libs": "nx run-many --target=build --exclude=api,app --configuration=production",
    "publish:app": "nx run app:deploy --no-silent",
    "test": "nx run-many --target=test --parallel=false --runInBand --detectOpenHandles --all --coverage=true --coverageReporters=lcov --watch=false --browsers=ChromeHeadless && node coverage-merger.js",
    "lint": "nx report && nx run-many --target=lint --all",
    "lint:fix": "nx report && nx run-many --target=lint --all --fix",
    "format": "nx format:write",
    "format:write": "prettier . --write",
    "format:check": "prettier . --check",
    "update": "nx migrate latest",
    "dep-graph": "nx dep-graph",
    "clear": "yarn clear:nx && yarn clear:modules && yarn clear:webpack && yarn clear:dist",
    "clear:nx": "rimraf -rf ./node_modules/.cache/nx",
    "clear:modules": "rimraf -rf ./node_modules",
    "clear:webpack": "rimraf -rf ./node_modules/.cache/webpack",
    "clear:dist": "rimraf -rf ./dist/",
    "report": "nx report",
    "release": "standard-version",
    "release:major": "standard-version --release-as major",
    "release:minor": "standard-version --release-as minor",
    "release:patch": "standard-version --release-as patch",
    "test:integration": "jest --config=jest.config.ts --testMatch='**/*.integration.spec.ts' --runInBand --detectOpenHandles",
    "test:stress": "jest --config=libs/pg-pubsub/jest.config.ts --testPathIgnorePatterns='integration' --testMatch='**/*.stress.spec.ts' --runInBand --detectOpenHandles"
  },
  "private": true,
  "dependencies": {
    "@angular/animations": "22.0.6",
    "@angular/cdk": "22.0.4",
    "@angular/common": "22.0.6",
    "@angular/compiler": "22.0.6",
    "@angular/core": "22.0.6",
    "@angular/forms": "22.0.6",
    "@angular/platform-browser": "22.0.6",
    "@angular/platform-browser-dynamic": "22.0.6",
    "@angular/router": "22.0.6",
    "@cisstech/nge": "^22.4.2",
    "@golevelup/nestjs-discovery": "^5.0.0",
    "@nestjs/common": "^11.0.0",
    "@nestjs/config": "^4.0.0",
    "@nestjs/core": "^11.0.0",
    "@nestjs/platform-express": "^11.0.0",
    "@nestjs/platform-socket.io": "^11.0.0",
    "@nestjs/swagger": "^11.0.0",
    "@nestjs/typeorm": "^11.0.0",
    "@nestjs/websockets": "^11.0.0",
    "@types/uuid": "^10.0.0",
    "axios": "1.13.5",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.0",
    "ioredis": "^5.6.0",
    "marked": "^11.0.1",
    "monaco-editor": "^0.52.2",
    "pg": "^8.14.0",
    "pg-listen": "^1.7.0",
    "reflect-metadata": "^0.1.13",
    "rxjs": "^7.8.0",
    "socket.io": "^4.8.1",
    "socket.io-client": "^4.8.1",
    "tslib": "^2.3.0",
    "typeorm": "^0.3.21",
    "uuid": "^11.1.0",
    "zone.js": "0.16.2"
  },
  "devDependencies": {
    "@angular-devkit/build-angular": "22.0.6",
    "@angular-devkit/core": "22.0.6",
    "@angular-devkit/schematics": "22.0.6",
    "@angular-eslint/eslint-plugin": "22.0.0",
    "@angular-eslint/eslint-plugin-template": "22.0.0",
    "@angular-eslint/template-parser": "22.0.0",
    "@angular/cli": "22.0.6",
    "@angular/compiler-cli": "22.0.6",
    "@angular/language-service": "22.0.6",
    "@angular/platform-server": "^22.0.0",
    "@angular/ssr": "^22.0.0",
    "@commitlint/cli": "^18.4.3",
    "@commitlint/config-conventional": "^18.4.3",
    "@eslint/eslintrc": "^3.0.0",
    "@eslint/js": "^9.8.0",
    "@nestjs/schematics": "11.1.0",
    "@nestjs/testing": "^11.0.0",
    "@nx/angular": "23.1.0-rc.0",
    "@nx/devkit": "23.1.0-rc.0",
    "@nx/eslint": "23.1.0-rc.0",
    "@nx/eslint-plugin": "23.1.0-rc.0",
    "@nx/jest": "23.1.0-rc.0",
    "@nx/js": "23.1.0-rc.0",
    "@nx/nest": "23.1.0-rc.0",
    "@nx/node": "23.1.0-rc.0",
    "@nx/webpack": "23.1.0-rc.0",
    "@nx/workspace": "23.1.0-rc.0",
    "@schematics/angular": "22.0.6",
    "@swc-node/register": "1.11.1",
    "@swc/core": "1.15.8",
    "@types/jest": "30.0.0",
    "@types/node": "^24",
    "@types/pg": "^8.11.11",
    "@types/supertest": "^6.0.2",
    "@typescript-eslint/eslint-plugin": "8.63.0",
    "@typescript-eslint/parser": "8.63.0",
    "@typescript-eslint/utils": "8.63.0",
    "angular-cli-ghpages": "^2.0.1",
    "angular-eslint": "^22.0.0",
    "concurrently": "^8.2.2",
    "cz-conventional-changelog": "^3.3.0",
    "eslint": "9.9.1",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-prettier": "^5.0.1",
    "glob": "^11",
    "husky": "^8.0.3",
    "jest": "30.4.2",
    "jest-environment-jsdom": "30.4.1",
    "jest-environment-node": "^30.0.0",
    "jest-preset-angular": "17.0.0",
    "jest-util": "30.4.1",
    "jsonc-eslint-parser": "^2.1.0",
    "nx": "23.1.0-rc.0",
    "prettier": "^3.1.0",
    "shiki": "^4.3.1",
    "standard-version": "^9.5.0",
    "supertest": "^7.0.0",
    "sync-json": "^1.0.2",
    "ts-jest": "29.4.9",
    "ts-node": "10.9.1",
    "typedoc": "^0.28.20",
    "typescript": "6.0.3",
    "typescript-eslint": "^8.58.0",
    "wait-on": "^7.2.0",
    "webpack-bundle-analyzer": "^4.10.1",
    "webpack-cli": "^7.0.0",
    "webpack-dev-server": "5.2.6"
  },
  "config": {
    "commitizen": {
      "path": "./node_modules/cz-conventional-changelog"
    }
  },
  "husky": {
    "hooks": {
      "commit-msg": "commitlint -E HUSKY_GIT_PARAMS"
    }
  },
  "commitlint": {
    "extends": [
      "@commitlint/config-conventional"
    ]
  },
  "nx": {
    "includedScripts": []
  },
  "resolutions": {
    "wrap-ansi": "7.0.0",
    "string-width": "4.2.0"
  },
  "publishConfig": {
    "registry": "https://registry.npmjs.org"
  },
  "packageManager": "yarn@4.12.0+sha256.1fe4e1193cbcd13a48d8f436bb17d3c672b049a5e32a758aab9866a073db1702"
}
