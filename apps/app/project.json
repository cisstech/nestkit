{
  "name": "app",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "projectType": "application",
  "prefix": "app",
  "sourceRoot": "apps/app/src",
  "tags": ["scope:app", "type:app"],
  "targets": {
    "build": {
      "executor": "@angular-devkit/build-angular:application",
      "outputs": ["{options.outputPath}"],
      "defaultConfiguration": "production",
      "options": {
        "outputPath": "dist/apps/app",
        "index": "apps/app/src/index.html",
        "browser": "apps/app/src/main.ts",
        "polyfills": ["zone.js"],
        "tsConfig": "apps/app/tsconfig.app.json",
        "inlineStyleLanguage": "scss",
        "assets": [
          "apps/app/src/favicon.ico",
          "apps/app/src/assets",
          {
            "glob": "**/*",
            "input": "./node_modules/@cisstech/nge/assets/markdown/",
            "output": "./assets/vendors/nge/markdown/"
          },
          {
            "glob": "**/*",
            "input": "apps/app/public",
            "output": "."
          }
        ],
        "styles": ["apps/app/src/styles.scss"],
        "scripts": [],
        "server": "apps/app/src/main.server.ts",
        "outputMode": "static"
      },
      "configurations": {
        "production": {
          "budgets": [
            {
              "type": "initial",
              "maximumWarning": "500kb",
              "maximumError": "1mb"
            },
            {
              "type": "anyComponentStyle",
              "maximumWarning": "2kb",
              "maximumError": "4kb"
            }
          ],
          "outputHashing": "all",
          "baseHref": "/nestkit/"
        },
        "development": {
          "optimization": false,
          "extractLicenses": false,
          "sourceMap": true
        }
      },
      "dependsOn": ["docs"]
    },
    "serve": {
      "executor": "@angular-devkit/build-angular:dev-server",
      "defaultConfiguration": "development",
      "continuous": true,
      "options": {
        "proxyConfig": "apps/app/proxy.conf.json"
      },
      "configurations": {
        "production": {
          "buildTarget": "app:build:production"
        },
        "development": {
          "buildTarget": "app:build:development"
        }
      }
    },
    "extract-i18n": {
      "executor": "@angular-devkit/build-angular:extract-i18n",
      "options": {
        "buildTarget": "app:build"
      }
    },
    "lint": {
      "executor": "@nx/eslint:lint"
    },
    "test": {
      "executor": "@nx/jest:jest",
      "outputs": ["{workspaceRoot}/coverage/{projectRoot}"],
      "options": {
        "jestConfig": "apps/app/jest.config.ts",
        "tsConfig": "apps/app/tsconfig.spec.json"
      }
    },
    "deploy": {
      "executor": "nx:run-commands",
      "options": {
        "parallel": false,
        "commands": [
          "nx build app --configuration production",
          "bash scripts/stage-ghpages.sh dist/apps/app/browser",
          "angular-cli-ghpages --no-build --dir=dist/apps/app/browser --repo=https://github.com/cisstech/nestkit.git"
        ]
      }
    },
    "docs": {
      "executor": "@cisstech/nge:docs",
      "options": {
        "publicDir": "apps/app/public",
        "root": "/docs",
        "name": "NestKit",
        "nav": "tabs",
        "siteUrl": "https://cisstech.github.io/nestkit",
        "api": {
          "entryPoints": ["libs/expand/src/index.ts", "libs/pg-pubsub/src/index.ts"],
          "tsconfig": "tsconfig.docs.json"
        }
      }
    }
  }
}
